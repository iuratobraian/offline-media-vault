[Unit]
Description=Offline Media Vault Server 24/7
After=network.target

[Service]
Type=simple
User=biurato
WorkingDirectory=/home/biurato/Escritorio/REPRODUCTOR OFFLINE/offline-media-vault (V2)
ExecStart=/home/biurato/.bun/bin/bun run server.ts
Restart=always
RestartSec=5
Environment=PORT=3000
Environment=HOST=0.0.0.0
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
